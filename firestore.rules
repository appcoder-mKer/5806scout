rules_version = '2';

// Team-scoped access model:
// - users/{uid} — a scout/admin profile. teamId + role live here.
// - teams/{teamId} — one doc per FRC team, plus subcollections (pit scout,
//   match scout, etc. added in later milestones) that inherit the same
//   same-team read/write rule below.
//
// Getting in: signing up grants nothing. Every profile is created pending and
// as a scout — both pinned below — and somebody else decides:
//
//  - a team's own admin approves a teammate from the Team tab;
//  - the app's OPERATOR approves a team's first member, who has no admin to
//    vouch for them, after looking at the evidence they filed at
//    teamClaims/{teamId}.
//
// Operator authority is owners/{uid}: a document created by hand in the
// Firebase console, readable only by its owner and writable by nobody at all.
// That is the one privilege the app cannot mint for itself, which is what
// stops a bug in the app from handing it out.
//
// Admin is therefore only ever granted — by the operator to a founder, or by
// an existing admin promoting a teammate. Self-escalation is blocked at both
// ends: a member may not change their own role, and may not change their own
// status either.
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function myProfile() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    // Every client is created pending (below), so the default here is what
    // holds an unapproved member out of their own team's data. Profiles
    // written before approval existed have no such field, and .get()'s default
    // sweeps them into the queue rather than through it — a missing approval
    // is not an approval.
    function isApproved() {
      return myProfile().get('status', 'pending') == 'approved';
    }

    function isOwner() {
      return isSignedIn()
        && exists(/databases/$(database)/documents/owners/$(request.auth.uid));
    }

    function isSameTeam(teamId) {
      return isSignedIn() && myProfile().teamId == teamId && isApproved();
    }

    function isAdminOfTeam(teamId) {
      return isSameTeam(teamId) && myProfile().role == 'admin';
    }

    function myTeamId() {
      return myProfile().teamId;
    }

    // Sister-team link (src/lib/sisterTeam.ts): only a MUTUAL link grants
    // cross-team access — both team docs must point at each other. A team
    // doc only gains its pointer via its own admin or an invite-code
    // redemption (below), so a lone forged sisterTeamId grants nothing.
    function isLinkedSisterTeam(teamId) {
      return isSignedIn()
        && isApproved()
        && teamId != myTeamId()
        && get(/databases/$(database)/documents/teams/$(myTeamId())).data.sisterTeamId == teamId
        && get(/databases/$(database)/documents/teams/$(teamId)).data.sisterTeamId == myTeamId();
    }

    // A linked sister team's admin. Sister access is granted collection by
    // collection below; deleting through it takes the same rank as deleting
    // at home, since the pair shares one store.
    function isSisterAdmin(teamId) {
      return isLinkedSisterTeam(teamId) && myProfile().role == 'admin';
    }

    function sisterLinkKeys() {
      return ["sisterTeamId", "sisterTeamNumber", "sisterTeamName", "sisterLinkedAt", "sisterLinkCode"];
    }

    match /users/{userId} {
      // Signup: a user may only create their own profile, and only as a
      // pending scout. This is the hole that used to be here — the old rule
      // allowed 'admin' at create time, so anyone who knew a team number could
      // sign up as that team's admin.
      allow create: if isSignedIn()
        && request.auth.uid == userId
        && request.resource.data.role == 'scout'
        && request.resource.data.status == 'pending'
        && request.resource.data.active == true;

      // Read: yourself, any teammate (so scouts/admins can see the roster),
      // or a linked sister team's member — pooled scouting assignments need
      // both rosters.
      // The operator branch carries no dependency on resource.data, so it also
      // satisfies the unfiltered collection query /owner runs.
      allow read: if isSignedIn()
        && (request.auth.uid == userId
          || isOwner()
          || isSameTeam(resource.data.teamId)
          || isLinkedSisterTeam(resource.data.teamId));

      // Update: yourself (profile edits), or a team admin managing the roster
      // (activate/deactivate, and promoting a teammate to admin or back to
      // scout) — but a non-admin can never grant themselves the admin role or
      // move themselves to another team.
      allow update: if isSignedIn()
        && (
          (request.auth.uid == userId
            && request.resource.data.role == resource.data.role
            && request.resource.data.teamId == resource.data.teamId
            // Same default on both sides, because a profile that predates the
            // field would otherwise throw here and lock its owner out of
            // editing anything at all.
            && request.resource.data.get('status', 'pending')
                 == resource.data.get('status', 'pending'))
          || isAdminOfTeam(resource.data.teamId)
          || isOwner()
        );

      allow delete: if false;
    }

    match /teams/{teamId} {
      // Bootstrap: any signed-in user can create the team doc for their own
      // team number if it doesn't exist yet (first signup for a new team).
      allow create: if isSignedIn() && !exists(/databases/$(database)/documents/teams/$(teamId));

      // Single-doc reads are public (no sensitive data — teamNumber/teamName)
      // so signup and the team-lookup UI can resolve a team number before the
      // visitor is signed in. Listing the collection still requires
      // membership.
      allow get: if true;
      allow list: if isSameTeam(teamId) || isOwner();

      // Signing up as an admin no longer touches this doc at all — the role
      // lives on users/{uid}, and a team that already exists is simply joined.
      //
      // This rule is admin-only, but note it is not the whole story: the
      // recursive `match /{document=**}` further down also matches the team
      // doc itself, so any teammate can in practice write it. Nothing is
      // granted by that (authority comes from users/{uid}.role) — see the
      // "gains a scout nothing" case in firestore.rules.test.ts.
      // The operator stamps claimedAt when a team gets its first admin — the
      // flag a pending member reads to know whether to file a claim or simply
      // wait for one of their own admins.
      allow update: if isAdminOfTeam(teamId)
        || isOwner()
        // Sister-team link: the OTHER team's admin stamps this team's half
        // of the link by presenting a live invite code this team's admin
        // generated (sisterInvites/{code} with fromTeamId == this team).
        // Only the link fields may change, and only onto an unlinked team.
        || (
          isSignedIn()
          && myProfile().role == 'admin'
          && teamId != myTeamId()
          && request.resource.data.sisterTeamId == myTeamId()
          && !("sisterTeamId" in resource.data)
          && get(/databases/$(database)/documents/sisterInvites/$(request.resource.data.sisterLinkCode)).data.fromTeamId == teamId
          && request.time.toMillis() <= get(/databases/$(database)/documents/sisterInvites/$(request.resource.data.sisterLinkCode)).data.expiresAt
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(sisterLinkKeys())
        )
        // Sister-team unlink: either side's admin may sever a mutual link,
        // removing the link fields and touching nothing else.
        || (
          isSignedIn()
          && myProfile().role == 'admin'
          && resource.data.sisterTeamId == myTeamId()
          && get(/databases/$(database)/documents/teams/$(myTeamId())).data.sisterTeamId == teamId
          && !("sisterTeamId" in request.resource.data)
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(sisterLinkKeys())
        );
      allow delete: if false;

      // Subcollections (pit scout, match scout, etc.) inherit team scoping.
      // Collecting is everyone's job, so any teammate may create and edit —
      // but DELETING is admin-only. The Team tab's reset clears an entire
      // event in one action, and a scout mid-match must not be able to take
      // the season's data with them, by mistake or otherwise.
      match /{document=**} {
        allow read, create, update: if isSameTeam(teamId);
        allow delete: if isAdminOfTeam(teamId);
      }

      // A verified sister team shares the canonical store's scouting data —
      // but never what a team works out for itself. The picklist is one:
      // each team ranks (and DNPs) alone, so config/picklist stays
      // same-team-only (the wildcard above). Strategy Boards are the other,
      // and get no match block here at all for the same reason — a pair
      // shares what it observed, not the plan each side drew from it.
      match /config/{docId} {
        allow read, create, update: if docId != "picklist" && isLinkedSisterTeam(teamId);
        allow delete: if docId != "picklist" && isSisterAdmin(teamId);
      }
      match /pitScouting/{docId} {
        allow read, create, update: if isLinkedSisterTeam(teamId);
        allow delete: if isSisterAdmin(teamId);
      }
      // Robot photos and drawings. A sibling collection to pitScouting purely
      // for weight (see src/lib/formMedia.ts) — the pit form splits them out
      // so a listener on pitScouting doesn't drag every photo at the event
      // over venue wifi. They are pit scouting data, so a linked sister team
      // reaches them on the same terms; without this the pair shares a
      // robot's answers but not its pictures.
      match /pitScoutingMedia/{docId} {
        allow read, create, update: if isLinkedSisterTeam(teamId);
        allow delete: if isSisterAdmin(teamId);
      }
      match /matchScouting/{docId} {
        allow read, create, update: if isLinkedSisterTeam(teamId);
        allow delete: if isSisterAdmin(teamId);
      }
      // The one carve-out from admin-only deletes: whoever posted a talkie
      // request may withdraw it, which is all the Talkie tab ever offers a
      // scout (see handleDelete there). Someone else's request still takes an
      // admin, on either team of a pair.
      match /talkie/{docId} {
        allow read, create, update: if isLinkedSisterTeam(teamId);
        allow delete: if isSisterAdmin(teamId)
          || (
            (isSameTeam(teamId) || isLinkedSisterTeam(teamId))
            && resource.data.createdByUid == request.auth.uid
          );
      }
    }

    // Operator identity. Created by hand in the Firebase console and writable
    // by nobody — see the header comment. The `get` is scoped to your own uid
    // so a non-owner reading their own missing doc gets a clean "doesn't
    // exist" instead of an error the client has to swallow.
    match /owners/{ownerId} {
      allow get: if isSignedIn() && request.auth.uid == ownerId;
      allow list: if false;
      allow write: if false;
    }

    // A team's first member proving the team is theirs, with the evidence
    // attached (src/lib/teamClaims.ts). The evidence is a photograph of a
    // student, so the operator's decision write deletes it in the same batch.
    match /teamClaims/{teamId} {
      // Reading a claim that DOESN'T exist is allowed, and that matters: it is
      // how the approval gate tells "nobody has claimed this team, offer the
      // form" apart from "someone else got here first", which would otherwise
      // both arrive as the same permission error.
      allow get: if isSignedIn()
        && (resource == null
          || resource.data.requestedByUid == request.auth.uid
          || isOwner());
      allow list: if isOwner();

      // First claim wins — create only succeeds while the doc is absent.
      allow create: if isSignedIn()
        && request.resource.data.requestedByUid == request.auth.uid
        && request.resource.data.status == 'pending';

      // A declined founder may send better evidence, which puts the claim back
      // in the queue; they can never move it out of one.
      allow update: if isOwner()
        || (
          isSignedIn()
          && resource.data.requestedByUid == request.auth.uid
          && resource.data.status != 'approved'
          && request.resource.data.status == 'pending'
          && request.resource.data.requestedByUid == resource.data.requestedByUid
          && request.resource.data.diff(resource.data).affectedKeys()
               .hasOnly(['evidenceKind', 'evidenceNote', 'evidenceImage', 'status'])
        );

      allow delete: if isOwner();
    }

    // One-time sister-team invite codes (src/lib/sisterTeamOps.ts). The
    // random code itself is the capability — it's only ever shown to the two
    // admins — so any signed-in holder may look one up, but never list them.
    match /sisterInvites/{code} {
      allow get: if isSignedIn();
      allow list: if false;
      allow create: if isSignedIn()
        && myProfile().role == 'admin'
        && request.resource.data.fromTeamId == myTeamId()
        && request.resource.data.createdByUid == request.auth.uid;
      allow update: if false;
      // Consumed on redemption by the other team's admin, or cancelled by
      // its creator; both are admins holding the code.
      allow delete: if isSignedIn() && myProfile().role == 'admin';
    }
  }
}
